{
  "name": "audio-orb",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npx firebase deploy --only hosting",
    "serve": "npx serve -s dist",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md}\"",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.15.0",
    "@lit/context": "^1.1.5",
    "firebase": "^12.17.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lit": "^3.3.0",
    "three": "^0.176.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.10.0",
    "firebase-tools": "^15.30.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.2.5",
    "serve": "^14.2.6",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.2.0",
    "vitest": "^4.1.11"
  }
}
