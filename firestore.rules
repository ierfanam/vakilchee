rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if signedInAs(userId);
      allow create, update: if signedInAs(userId)
        && request.resource.data.uid == userId;
      allow delete: if signedInAs(userId);

      match /memories/{docId} {
        allow read: if signedInAs(userId);
        allow create: if signedInAs(userId)
          && request.resource.data.userId == userId;
        allow update: if signedInAs(userId)
          && resource.data.userId == userId
          && request.resource.data.userId == userId;
        allow delete: if signedInAs(userId) && resource.data.userId == userId;
      }

      match /sessions/{docId} {
        allow read: if signedInAs(userId);
        allow create: if signedInAs(userId)
          && request.resource.data.userId == userId;
        allow update: if signedInAs(userId)
          && resource.data.userId == userId
          && request.resource.data.userId == userId;
        allow delete: if signedInAs(userId) && resource.data.userId == userId;
      }

      match /documents/{docId} {
        allow read: if signedInAs(userId);
        allow create: if signedInAs(userId)
          && request.resource.data.userId == userId;
        allow update: if signedInAs(userId)
          && resource.data.userId == userId
          && request.resource.data.userId == userId;
        allow delete: if signedInAs(userId) && resource.data.userId == userId;
      }

      match /judicial_forms/{docId} {
        allow read: if signedInAs(userId);
        allow create: if signedInAs(userId)
          && request.resource.data.userId == userId;
        allow update: if signedInAs(userId)
          && resource.data.userId == userId
          && request.resource.data.userId == userId;
        allow delete: if signedInAs(userId) && resource.data.userId == userId;
      }
    }
  }
}
